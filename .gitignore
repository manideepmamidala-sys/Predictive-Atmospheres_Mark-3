# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments
.env
.venv/
env/
venv/
venv*/
env*/
ENV/
env.bak/
venv.bak/

# Models
*.pt
*.pth
*.pkl

# VS Code
.vscode/
.vscode/ipch/

# IDE caches
.idea/
*.code-workspace

# Streamlit
.streamlit/

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# Reference repos (not part of the project source)
repos/

# Data + generated artifacts (heavy)
data/raw/
data/processed/
artifacts/reports/
