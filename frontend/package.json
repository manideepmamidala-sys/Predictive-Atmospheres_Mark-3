{
  "name": "predictive-atmospheres-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/stage-research.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "pretest": "node scripts/stage-research.mjs && npm run api:check && npm run typecheck",
    "test": "playwright test",
    "api:types": "openapi-typescript ../artifacts/results/openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../artifacts/results/openapi.json -o src/api/schema.check.d.ts && cmp src/api/schema.d.ts src/api/schema.check.d.ts && rm src/api/schema.check.d.ts",
    "research:stage": "node scripts/stage-research.mjs"
  },
  "dependencies": {
    "@fontsource/public-sans": "5.2.7",
    "@fontsource/source-serif-4": "5.2.8",
    "@observablehq/plot": "0.6.17",
    "d3-contour": "4.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/d3-contour": "3.0.6",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.10.1",
    "sharp": "0.34.4",
    "typescript": "5.9.3",
    "vite": "6.3.6"
  }
}
