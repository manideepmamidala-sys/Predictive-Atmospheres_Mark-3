# Local Vite dev uses /v1 proxy to PA_API_URL; leave browser base empty locally.
PA_API_URL=http://127.0.0.1:8000
# For a separately hosted API, set the public HTTPS origin at build time.
# VITE_API_BASE_URL=https://your-api.onrender.com
# Set to the published branch or commit that includes preserved originals.
VITE_REPOSITORY_REF=261008-ymhz-research-platform-rebuild
# Require manifest-matched bundle and signals products in release builds.
PA_REQUIRE_RESEARCH_EXPORT=1
