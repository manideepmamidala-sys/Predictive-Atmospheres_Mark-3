# Upload only the inputs required for the static build and trusted API.
/*
!/.python-version
!/.vercelignore
!/api
!/artifacts
!/backend
!/data
!/docs
!/frontend
!/requirements.txt
!/vercel.json

/artifacts/*
!/artifacts/model
!/artifacts/results
/artifacts/model/*
!/artifacts/model/metadata.json
!/artifacts/model/model.joblib
/artifacts/results/*
!/artifacts/results/analysis
!/artifacts/results/bundle.json
!/artifacts/results/manifest.json
!/artifacts/results/qc_review.json
!/artifacts/results/signals.json

/backend/*
!/backend/pyproject.toml
!/backend/src
!/backend/uv.lock

/data/*
!/data/MANIFEST.sha256
!/data/metadata
!/data/renders
/data/renders/*
!/data/renders/manifest.json

/docs/*
!/docs/specs
/docs/specs/*
!/docs/specs/analysis-v1.2-draft.md

/frontend/dist
/frontend/frontend
/frontend/node_modules
/frontend/public/research
/frontend/test-results
/frontend/tests
/frontend/tsconfig.tsbuildinfo
/_uv
